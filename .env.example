# Sentora Community Edition — environment template
# Copy to .env and replace every <PLACEHOLDER> before booting the stack.



# ─── Database ────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
# Required — compose refuses to start without it.
DB_PASSWORD=<CHANGE-ME-strong-mysql-password>

# ─── Message broker ──────────────────────────────────────────────────────
# Required. The broker used to run on the well-known guest/guest, which is
# also what core/mq.py falls back to. Filled in by scripts/init_secrets.py.
RABBITMQ_USER=sentora
RABBITMQ_PASSWORD=

# ─── Service port exposure ───────────────────────────────────────────────
# Host interface for the supporting services (MySQL, RabbitMQ, OpenSearch,
# Dashboards, Ollama). `app` (:8000) and `ingest` (:5001) always listen on
# all interfaces — everything else defaults to loopback because none of them
# authenticate. Widen only behind an authenticating reverse proxy.
BIND_ADDR=127.0.0.1

# ─── Ingestion ───────────────────────────────────────────────────────────
INGEST_BIND=0.0.0.0
INGEST_PORT=5001

# ─── Agent auth shared secret ────────────────────────────────────────────
# X-Agent-Key fallback for agents without a per-agent enrolled key. When this
# is unset app.py generates an ephemeral one at every boot, so the fallback
# breaks on each restart. Filled in by scripts/init_secrets.py.
AGENT_SHARED_SECRET=

# ─── Local AI (Ollama) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434/api
OLLAMA_MODEL=llama3.2:3b
# AI_AUTO_ACT_CONF=0.75   # confidence floor for autonomous SOAR actions
# AI_SHADOW_MODE=1        # stage defensive auto-actions for manual approval
                          # instead of dispatching. Pending proposals show up
                          # under SOAR Hub > Shadow Queue.

# ─── Sessions ────────────────────────────────────────────────────────────
# The UI authenticates with an HttpOnly session cookie. Both clocks are
# enforced: a session dies SESSION_IDLE_MINUTES after its last request, and
# unconditionally after SESSION_ABSOLUTE_HOURS.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Set to 1 once TLS terminates in front of the app. A Secure cookie over
# plain http is dropped by the browser and nobody can log in.
SESSION_COOKIE_SECURE=0
# Lax | Strict | None. Lax blocks the cross-site POST/XHR that CSRF needs
# while staying compatible with normal use.
SESSION_COOKIE_SAMESITE=Lax

# ─── Frontend ────────────────────────────────────────────────────────────
# Leave empty for the normal deployment: this app serves the SPA itself, so
# requests are same-origin and no CORS entry is required. A wildcard is
# rejected outright now — the browser refuses `Allow-Origin: *` on any
# request that carries cookies.
CORS_ORIGINS=
VITE_API_BASE_URL=http://localhost:8000

# ─── Outbound HTTP proxy (/_proxy/http) ──────────────────────────────────
# Lets playbook nodes reach third-party endpoints that don't send CORS
# headers. Empty means the endpoint is disabled — leave it that way unless
# you actually need it, because it is a server-side request forgery
# primitive by nature.
#
# Comma-separated hosts, optionally with a port. Subdomains are NOT implied:
# `example.com` does not permit `api.example.com`.
#   PROXY_ALLOWED_HOSTS=hooks.slack.com,jira.internal:8080
PROXY_ALLOWED_HOSTS=
PROXY_MAX_BYTES=5242880
PROXY_TIMEOUT_CAP=15
# Loopback and link-local (169.254.169.254 cloud metadata) are refused even
# for allowlisted hosts, and redirects are never followed.

# ─── OpenSearch ──────────────────────────────────────────────────────────
# NOTE: the cluster runs with DISABLE_SECURITY_PLUGIN, so it authenticates
# nothing — core/opensearch.py sends these and the server discards them. The
# port being bound to BIND_ADDR is what actually protects it.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ─── Threat Intel ────────────────────────────────────────────────────────
# Per-verdict enrichment in the AI worker. No-op when unset.
# OTX_API_KEY=
# VT_API_KEY=

# Indicator feeds for the threat_intel table. This used to be three hardcoded
# rows — one of them the SHA-256 of the empty string, marked CRITICAL.
#   auto   - pull the feeds below hourly
#   off    - no outbound request at all (air-gap)
THREAT_INTEL_MODE=auto
# Comma-separated subset; empty means all of them.
# THREAT_INTEL_FEEDS=feodo,threatfox,urlhaus
# abuse.ch has been moving downloads behind a free account key. Set this if a
# feed starts reporting 401/403 in the server log.
# THREAT_INTEL_AUTH_KEY=
# Override any feed URL to point at an internal mirror:
# THREAT_INTEL_FEODO_URL=http://mirror.internal/feodo.json
# THREAT_INTEL_THREATFOX_URL=
# THREAT_INTEL_URLHAUS_URL=
# Indicators not re-seen for this long are pruned — an IP that hosted a C2
# last quarter usually belongs to someone else now.
THREAT_INTEL_STALE_DAYS=30
THREAT_INTEL_MAX_PER_FEED=2000

# ─── Vulnerability Scanner (OSV) ─────────────────────────────────────────
# auto   - probe public OSV at boot; fall back to mirror if unreachable
# online - always use the public OSV API
# mirror - always use OSV_MIRROR_URL (fail-closed if unset)
OSV_MODE=auto
OSV_PUBLIC_URL=https://api.osv.dev
# OSV_MIRROR_URL=http://osv-mirror.internal:8080
VULN_SCAN_INTERVAL=1800

# ─── Fernet keys ─────────────────────────────────────────────────────────
# Server key: protects at-rest columns (e.g. the LDAP bind password). REQUIRED
# in containers — /app is not writable by the non-root app user, so there is
# no auto-generate fallback there and the app refuses to start without it.
# Filled in by scripts/init_secrets.py. Back it up: losing it makes existing
# encrypted values unreadable, and there is no in-place rotation.
FERNET_KEY=

# Agent key: protects agent telemetry, auto-generated on first boot and
# persisted to the `sentora_data` volume. Back that volume up too.
# FERNET_KEY_PATH=/app/data/fernet.key
