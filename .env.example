# ══════════════════════════════════════════════════════════════════════════
# Sentora Community Edition — environment template
#
#   cp .env.example .env
#   python scripts/init_secrets.py     # fills the generated secrets
#   # then set DB_PASSWORD by hand
#
# Values left EMPTY below are filled by scripts/init_secrets.py. Values shown
# commented out are optional — the default in the comment is what the code
# uses when they are unset.
#
# Never commit .env. It is git-ignored and excluded from the Docker image.
# ══════════════════════════════════════════════════════════════════════════


# ─── Database ────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
# REQUIRED — compose refuses to start without it. On an existing deployment
# use scripts/rotate_db_password.py: MySQL fixes the root password when the
# data volume is first initialised, so editing this alone locks the app out
# instead of changing the account.
DB_PASSWORD=<CHANGE-ME-strong-mysql-password>
# Name of the RBAC / audit / sessions database.
# USERDB_NAME=userdb


# ─── Message broker ──────────────────────────────────────────────────────
# REQUIRED. The broker used to run on the well-known guest/guest, which is
# also what core/mq.py falls back to when RABBITMQ_URL is unset.
# Avoid ':' '@' '/' in the password — compose interpolates it into an
# amqp:// URL without escaping.
RABBITMQ_USER=sentora
RABBITMQ_PASSWORD=
# Built by docker-compose from the two values above. Only set this by hand
# when running a worker outside compose.
# RABBITMQ_URL=amqp://sentora:password@rabbitmq/


# ─── Service port exposure ───────────────────────────────────────────────
# Host interface for the supporting services (MySQL, RabbitMQ, OpenSearch,
# Dashboards, Ollama). `app` (:8000) and `ingest` (:5001) always listen on
# all interfaces; everything else defaults to loopback because none of them
# authenticate — OpenSearch runs with its security plugin disabled and
# Dashboards is an unauthenticated view of every collected log.
# Widen only behind an authenticating reverse proxy.
BIND_ADDR=127.0.0.1
# Port the Sanic app listens on inside its container.
# PORT=8000


# ─── Ingestion ───────────────────────────────────────────────────────────
# TCP channel the agents ship telemetry to.
INGEST_BIND=0.0.0.0
INGEST_PORT=5001


# ─── Agent enrolment and callbacks ───────────────────────────────────────
# X-Agent-Key fallback for agents without a per-agent enrolled key. When
# unset, app.py generates an ephemeral one at every boot, so the fallback
# breaks on each restart. Filled in by scripts/init_secrets.py.
AGENT_SHARED_SECRET=
# How long a one-time enrolment token stays valid.
# ENROLLMENT_TOKEN_TTL_HOURS=24
# Port the server calls back on for agent-inbound requests (config push,
# SOAR execute, screen stream).
# AGENT_PORT=5000


# ─── TLS (optional) ──────────────────────────────────────────────────────
# Off by default: the stack is expected to sit behind a reverse proxy that
# terminates TLS. Set TLS_ENABLED=1 to have Sanic serve HTTPS directly.
# Remember SESSION_COOKIE_SECURE=1 once TLS is in play, wherever it
# terminates.
# TLS_ENABLED=0
# TLS_CERT=certs/server.crt
# TLS_KEY=certs/server.key


# ─── Sessions ────────────────────────────────────────────────────────────
# The UI authenticates with an HttpOnly session cookie; userdb.sessions is
# the authority and only the SHA-256 of each token is stored. Both clocks
# are enforced: a session dies SESSION_IDLE_MINUTES after its last request,
# and unconditionally after SESSION_ABSOLUTE_HOURS.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Set to 1 once TLS terminates in front of the app. A Secure cookie sent
# over plain http is dropped by the browser and nobody can log in.
SESSION_COOKIE_SECURE=0
# Lax | Strict | None
#   Lax    — blocks the cross-site POST/XHR that CSRF needs (default)
#   Strict — also withholds the cookie on inbound links
#   None   — required for split-origin deployments; needs SECURE=1
SESSION_COOKIE_SAMESITE=Lax


# ─── Frontend / CORS ─────────────────────────────────────────────────────
# Leave empty for the normal deployment: the app serves the SPA itself, so
# requests are same-origin and no CORS entry is required. A wildcard is
# rejected outright — browsers refuse `Allow-Origin: *` on any request that
# carries cookies. Split-origin setups list explicit origins here and set
# SESSION_COOKIE_SAMESITE=None with SESSION_COOKIE_SECURE=1.
CORS_ORIGINS=
# Build-time only, and only used by `npm run dev`. The Docker build leaves
# it empty so the SPA falls back to window.location.origin.
# Heads up: the dev server on :5173 talking to :8000 is cross-site, and
# SameSite=Lax withholds the session cookie there, so login will not stick.
# Either build the frontend and let app.py serve it, or add a Vite proxy.
VITE_API_BASE_URL=http://localhost:8000


# ─── Local AI (Ollama) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434/api
OLLAMA_MODEL=llama3.2:3b

# Confidence floors for the automation worker. A verdict below these is
# recorded as reviewed rather than escalated.
# AI_CRIT_CONF=0.6          # CRITICAL verdicts
# AI_SUS_CONF=0.75          # SUSPICIOUS verdicts

# Per-request inference timeout. A local 3B model answers in 20-60s on CPU;
# this used to be 600s, which was not a timeout but a hang — one stuck
# request held the worker's only slot for ten minutes.
# AI_TIMEOUT_SEC=120

# Events in flight per worker. Ollama serialises requests per model unless
# OLLAMA_NUM_PARALLEL is raised, and on CPU more parallelism splits the same
# compute rather than adding throughput. Raise both together, and only on a
# GPU box. The `[ai] ... responded in Ns` log line shows whether it helped.
# AI_CONCURRENCY=1

# Cached verdicts expire after this. Previously there was no TTL and no
# prompt version, so one bad answer was served until someone dropped the
# table by hand.
# AI_CACHE_TTL_HOURS=24
# Bump to invalidate every cached verdict after changing a prompt.
# AI_PROMPT_VERSION=v1

# Autonomous SOAR dispatch by the defensive worker. Set to 1.0 to disable
# autonomy entirely while still producing advisory insights.
# AI_AUTO_ACT_CONF=0.75

# Shadow mode: stage defensive auto-actions as proposals for operator
# approval instead of dispatching them. Pending proposals appear under
# SOAR Hub > Shadow Queue and never expire.
# AI_SHADOW_MODE=1

# Periodic sweep that pushes recent alerts through the defensive worker.
# AI_DEFENSIVE_SWEEP_ENABLED=1
# AI_DEFENSIVE_SWEEP_SEC=300     # interval between sweeps
# AI_DEFENSIVE_SWEEP_BATCH=5     # alerts per sweep; a local model takes
#                                # 20-60s per event on CPU


# ─── Outbound HTTP proxy (/_proxy/http) ──────────────────────────────────
# Lets playbook nodes reach third-party endpoints that don't send CORS
# headers. EMPTY MEANS DISABLED — leave it that way unless you need it,
# because it is a server-side request forgery primitive by nature.
#
# Comma-separated hosts, optionally with a port. Subdomains are NOT implied:
# `example.com` does not permit `api.example.com`.
#   PROXY_ALLOWED_HOSTS=hooks.slack.com,jira.internal:8080
PROXY_ALLOWED_HOSTS=
# Response body cap and per-request timeout ceiling.
PROXY_MAX_BYTES=5242880
PROXY_TIMEOUT_CAP=15
# Not configurable, for good reason: loopback and link-local (including
# 169.254.169.254 cloud metadata) are refused even for allowlisted hosts,
# redirects are never followed, and Set-Cookie is never relayed back.


# ─── OpenSearch ──────────────────────────────────────────────────────────
# NOTE: the cluster runs with DISABLE_SECURITY_PLUGIN, so it authenticates
# nothing — core/opensearch.py sends these and the server discards them.
# The port being bound to BIND_ADDR is what actually protects it. The
# password is generated separately anyway so it is not shared with
# DB_PASSWORD if the security plugin is ever enabled.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=


# ─── Threat intel: per-verdict enrichment ────────────────────────────────
# Used by the AI worker to cross-check indicators found in a log. No-op
# when unset, which keeps the stack air-gap-friendly.
# OTX_API_KEY=
# VT_API_KEY=


# ─── Threat intel: indicator feeds ───────────────────────────────────────
# Populates the threat_intel table. This used to be three hardcoded rows,
# one of them the SHA-256 of the empty string marked CRITICAL malware.
#   auto — pull the feeds below hourly
#   off  — no outbound request at all (air-gap)
THREAT_INTEL_MODE=auto
# Comma-separated subset; empty means all of them.
#   feodo     — abuse.ch Feodo Tracker, botnet C2 addresses
#   threatfox — abuse.ch ThreatFox, mixed IoCs with a confidence score
#   urlhaus   — abuse.ch URLhaus, malware-distributing URLs
# THREAT_INTEL_FEEDS=feodo,threatfox,urlhaus
# abuse.ch has been moving downloads behind a free account key. Set this if
# a feed starts reporting 401/403 in the server log.
# THREAT_INTEL_AUTH_KEY=
# Override any feed URL to point at an internal mirror:
# THREAT_INTEL_FEODO_URL=https://feodotracker.abuse.ch/downloads/ipblocklist.json
# THREAT_INTEL_THREATFOX_URL=https://threatfox.abuse.ch/export/json/recent/
# THREAT_INTEL_URLHAUS_URL=https://urlhaus.abuse.ch/downloads/json_recent/
# Indicators not re-seen for this long are pruned. An address that hosted a
# C2 last quarter usually belongs to someone else now, and keeping it
# produces false positives indefinitely.
THREAT_INTEL_STALE_DAYS=30
# Per-feed row cap. These lists run to tens of thousands and the table is
# read on the alert path.
THREAT_INTEL_MAX_PER_FEED=2000


# ─── Vulnerability scanner (OSV) ─────────────────────────────────────────
#   auto   — probe public OSV at boot; fall back to the mirror if unreachable
#   online — always use the public OSV API
#   mirror — always use OSV_MIRROR_URL (fail-closed if unset)
OSV_MODE=auto
OSV_PUBLIC_URL=https://api.osv.dev
# OSV_MIRROR_URL=http://osv-mirror.internal:8080
# Seconds between fleet-wide scans.
VULN_SCAN_INTERVAL=1800


# ─── Fernet keys ─────────────────────────────────────────────────────────
# Server key: protects at-rest columns (e.g. the LDAP bind password).
# REQUIRED in containers — /app is not writable by the non-root app user, so
# there is no auto-generate fallback there and the app refuses to start
# without it. Filled in by scripts/init_secrets.py.
# BACK IT UP. Losing it makes existing encrypted values unreadable, and
# there is no in-place rotation.
FERNET_KEY=

# Agent key: protects agent telemetry, handed out via /api/agents/bootstrap.
# Auto-generated on first boot and persisted to the `sentora_data` volume —
# back that volume up too.
# FERNET_KEY_PATH=/app/data/fernet.key


# ══════════════════════════════════════════════════════════════════════════
# Agent-side settings
#
# These are read by the agent process on the endpoint, not by the server.
# They belong in the agent's own config, not this file — listed here so the
# full set is discoverable in one place.
#
#   SENTORA_CONFIG            path to the agent's config file
#   AUTOMATIONS_API_URL       server URL the agent polls for SOAR tasks
#   AUTOMATIONS_MODE          poll | push
#   AGENT_DEBUG_AUTOMATIONS   verbose SOAR logging on the endpoint
#   AGENT_MASTER_SECRET       enables strict inbound auth on the agent
#   FERNET_REFRESH_SEC        how often the agent re-fetches its key
#   RULES_CONFIG              path to rules.yaml
# ══════════════════════════════════════════════════════════════════════════
