# Sentora Specific

# Evaluation data is per-deployment: real telemetry, hand-labelled.
# The harness is versioned, the corpus and run results are not.
evals/corpus.jsonl
evals/runs/*.json

# SonarQube scanner working files. Written on every scan and specific to one
# run; they were tracked, so each scan produced a spurious diff.
.sonar/
.scannerwork/

# TLS material is generated per deployment on first boot, never committed.
# A private key in the repository gives every install the same TLS identity
# and publishes it: anyone with a clone can impersonate the server. The
# generator (certs/generate_certs.py) is versioned; its output is not.
certs/*.key
certs/*.crt
certs/*.pem
certs/*.csr
