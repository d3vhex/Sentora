# Secrets — `COPY . /app` would otherwise bake these into every layer of the
# image, where anyone who can pull it can read them back out. Compose supplies
# the same values at runtime via `env_file`, so nothing needs them at build
# time.
.env
.env.*
!.env.example
data/
*.pem

# TLS material. No certificate or key ships any more: a committed private key
# gave every deployment the same TLS identity and published it, so anyone with
# a clone could impersonate the server. app.py generates a local pair on first
# boot when TLS is enabled and none is present (certs/generate_certs.py, which
# is source and stays in the image). Supply a real certificate by mounting it
# over certs/ or by pointing TLS_CERT / TLS_KEY elsewhere.
certs/*.key
certs/*.crt
certs/*.pem

# Build output and dependencies (rebuilt inside the image)
node_modules/
frontend/node_modules/
frontend/dist/
__pycache__/
*.py[cod]
.venv/
venv/

# Local model weights — gigabytes, and re-pulled by ollama-init
ollama/
models/
*.gguf
*.bin
*.onnx

# Not needed at runtime. docs/ alone carries ~28 MB of pptx/pdf.
.git/
.github/
docs/
tests/
.pytest_cache/
CONTRIBUTING.md
SECURITY.md

# Local tooling
.agent/
.claude/
.idea/
.vscode/
*.exe
